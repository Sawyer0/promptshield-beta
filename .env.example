# PromptShield Control Plane Configuration

# Database Configuration (Required)
# Get this from Supabase Project Settings > Database > Connection string
PS_PG_DSN="postgres://postgres:your-password@db.your-project.supabase.co:5432/postgres"

# Control Plane Server Configuration
PS_CONTROL_PLANE_ADDR=":8085"

# Redis Configuration (Optional - for real-time updates)
# Leave empty to disable messaging
PS_REDIS_ADDR=""

# Example with Redis:
# PS_REDIS_ADDR="localhost:6379"

# Tenant ID (Optional - for single-tenant deployments)
PS_TENANT_ID=""