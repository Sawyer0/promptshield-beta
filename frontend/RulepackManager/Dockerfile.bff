FROM node:20-alpine AS build
WORKDIR /app

# Install deps
COPY package*.json ./
RUN npm install --no-fund --no-audit

# Copy source and build (client + server)
COPY . .
# Inject Vite envs for client build
ARG VITE_CLERK_PUBLISHABLE_KEY
ENV VITE_CLERK_PUBLISHABLE_KEY=${VITE_CLERK_PUBLISHABLE_KEY}
# Vite builds client to dist/public; esbuild bundles server to dist/index.js
RUN npm run build

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3000

# Copy built artifacts and minimal package files
COPY --from=build /app/dist /app/dist
COPY --from=build /app/package*.json /app/

# Install only production dependencies (none required at runtime, but keep for future)
RUN npm ci --omit=dev || true

EXPOSE 3000
CMD ["node","dist/index.cjs"]
