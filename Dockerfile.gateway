ARG ENABLE_HYPERSCAN=0
ARG BUILDPLATFORM
ARG TARGETPLATFORM
ARG TARGETOS
ARG TARGETARCH

# Operator dashboard: static assets, identical for every target platform.
# The Vite build writes into the Go embed directory, mirrored here.
FROM --platform=$BUILDPLATFORM node:22-bookworm-slim AS dashboard
WORKDIR /src/web/dashboard
COPY web/dashboard/package.json web/dashboard/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --no-audit --no-fund
COPY web/dashboard/ ./
RUN mkdir -p /src/internal/interfaces/http/dashboard/dist && \
    npm run build && \
    test -s /src/internal/interfaces/http/dashboard/dist/index.html

FROM --platform=$BUILDPLATFORM golang:1.25 AS builder
ARG ENABLE_HYPERSCAN
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
ENV GOTOOLCHAIN=auto

# Cache modules
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Install Hyperscan headers when requested
RUN if [ "$ENABLE_HYPERSCAN" = "1" ]; then \
      apt-get update && \
      apt-get install -y --no-install-recommends libhyperscan-dev && \
      rm -rf /var/lib/apt/lists/*; \
    fi

# Build gateway (optionally with Hyperscan) with the dashboard embedded
COPY . .
COPY --from=dashboard /src/internal/interfaces/http/dashboard/dist/ ./internal/interfaces/http/dashboard/dist/
RUN test -s internal/interfaces/http/dashboard/dist/index.html
RUN --mount=type=cache,target=/go/pkg/mod \
    if [ "$ENABLE_HYPERSCAN" = "1" ]; then \
      CGO_ENABLED=1 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
      go build -tags hyperscan -trimpath -ldflags="-s -w" -o /out/ps-gateway ./gateway; \
    else \
      CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
      go build -trimpath -ldflags="-s -w" -o /out/ps-gateway ./gateway; \
    fi

FROM --platform=$TARGETPLATFORM debian:bookworm-slim
ARG ENABLE_HYPERSCAN
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates wget && \
    if [ "$ENABLE_HYPERSCAN" = "1" ]; then \
      apt-get install -y --no-install-recommends libhyperscan5; \
    fi && \
    rm -rf /var/lib/apt/lists/* && \
    useradd -m -u 10001 app && \
    mkdir -p /rules

COPY --from=builder /out/ps-gateway /usr/local/bin/ps-gateway

USER app
EXPOSE 9090 9091

HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1:9090/healthz || exit 1

ENTRYPOINT ["/usr/local/bin/ps-gateway"]
