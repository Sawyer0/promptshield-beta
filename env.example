# Database Configuration
# Replace with your actual Supabase connection string
PS_PG_DSN=postgresql://username:password@host:port/database

# Tenant Configuration
PS_TENANT_ID=your-tenant-id-here

# Enforcer Configuration
PS_ENFORCER_ENFORCEMENT_MODE=enforce
PS_ENFORCER_TIMEOUT=300ms
PS_ENFORCER_MAX_BODY_BYTES=10485760
PS_ENFORCER_FAIL_ON=HIGH

# Security & Auth
PS_ADMIN_TOKEN=your-secure-admin-token
PS_FRONTEND_TOKEN=your-secure-frontend-token
PS_ENFORCER_TLS_MODE=disable
PS_ENFORCER_GRPC_TLS_MODE=disable

# Semantic Analysis (ProtectAI DeBERTa)
PS_SEMANTIC_ENABLED=true
PS_DEBERTA_ENDPOINT=http://localhost:8089/infer
# Optional when using HuggingFace Inference
HF_TOKEN=your-hf-token
# Policy bridge weights and threshold
PS_ALPHA=0.7
PS_BETA=0.3
PS_BLOCK_THRESHOLD=0.75
# Conversation TTL (e.g., 15m)
PS_CONV_TTL=15m

# Telemetry
PS_TELEMETRY=1
PS_TELEMETRY_ENDPOINT=otel-collector:4317
# Optional sampling (0.0 - 1.0)
PS_TRACE_SAMPLE=1.0
# Disable gateway tracing (rare; for local perf tests)
PS_GATEWAY_DISABLE_TRACING=false
# Enable OTel logs (sends slog to the OTel Collector logs pipeline)
PS_OTEL_LOGS=true
# OTLP TLS (if you disable insecure; not wired yet)
PS_OTEL_INSECURE=true
PS_OTEL_CA_FILE=

# Optional tracing backends (via the OTel Collector)
# Tempo (receives OTLP gRPC)
TEMPO_OTLP_ENDPOINT=
TEMPO_INSECURE=true
TEMPO_CA_FILE=
# Jaeger (gRPC at :14250)
JAEGER_ENDPOINT=
JAEGER_INSECURE=true
JAEGER_CA_FILE=
# Loki logs (via collector-contrib)
LOKI_ENDPOINT=
LOKI_INSECURE=true
LOKI_TENANT_ID=
LOKI_CA_FILE=

# Session Configuration
SESSION_SECRET=your-long-random-session-secret
SESSION_STORE=redis
REDIS_URL=redis://localhost:6379
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_NAME=ps.sid

# BFF → Gateway JWT (RS256)
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
PS_BFF_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...base64...\n-----END PRIVATE KEY-----"
PS_BFF_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...base64...\n-----END PUBLIC KEY-----"
PS_BFF_JWT_ISSUER=promptshield-bff
PS_BFF_JWT_AUDIENCE=promptshield-gateway

# Clerk (server-side)
CLERK_SECRET_KEY=your-clerk-secret-key
# Clerk (client): set VITE_CLERK_PUBLISHABLE_KEY in frontend/.env or build env
VITE_CLERK_PUBLISHABLE_KEY=your-clerk-publishable-key

# Dev bypass (optional)
PS_DEV_BYPASS_AUTH=false
PS_DEV_USER_ID=dev-user
PS_DEV_USER_NAME=Dev User
PS_DEV_USER_EMAIL=dev@example.com
PS_DEV_TENANT_ID=
PS_DEV_ROLES=
PS_DEV_IS_ADMIN=false