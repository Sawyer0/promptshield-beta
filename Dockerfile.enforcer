ARG ENABLE_HYPERSCAN=0
ARG BUILDPLATFORM
ARG TARGETPLATFORM
ARG TARGETOS
ARG TARGETARCH

FROM --platform=$BUILDPLATFORM golang:1.24 AS builder
ARG ENABLE_HYPERSCAN
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src

# Cache modules
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download

# Install Hyperscan headers when requested
RUN if [ "$ENABLE_HYPERSCAN" = "1" ]; then \
      apt-get update && \
      apt-get install -y --no-install-recommends libhyperscan-dev && \
      rm -rf /var/lib/apt/lists/*; \
    fi

# Build gateway/enforcer (optionally with Hyperscan)
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    if [ "$ENABLE_HYPERSCAN" = "1" ]; then \
      CGO_ENABLED=1 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
      go build -tags hyperscan -trimpath -ldflags="-s -w" -o /out/ps-enforcer ./enforcer; \
    else \
      CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} \
      go build -trimpath -ldflags="-s -w" -o /out/ps-enforcer ./enforcer; \
    fi


FROM --platform=$TARGETPLATFORM debian:bookworm-slim
ARG ENABLE_HYPERSCAN
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates wget && \
    if [ "$ENABLE_HYPERSCAN" = "1" ]; then \
      apt-get install -y --no-install-recommends libhyperscan5; \
    fi && \
    rm -rf /var/lib/apt/lists/* && \
    useradd -m -u 10001 app && \
    mkdir -p /rules
COPY --from=builder /out/ps-enforcer /usr/local/bin/ps-enforcer

USER app
EXPOSE 9090 9091
ENV PS_ENFORCER_ADDR=:9090 \
    PS_ENFORCER_GRPC_ADDR=:9091

HEALTHCHECK --interval=30s --timeout=3s --retries=3 CMD wget -qO- http://127.0.0.1:9090/healthz || exit 1

ENTRYPOINT ["/usr/local/bin/ps-enforcer"]

