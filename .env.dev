# ============================
# PromptShield local dev (.env.dev)
# Auth bypasses enabled for faster UI iteration
# ============================

# ---- Gateway (Go)
PS_PG_DSN=postgresql://postgres.jsrlqqtfhjfiawxkmoqe:toBPdVDErZnna0xw@aws-1-us-west-1.pooler.supabase.com:5432/postgres
sslmode=disable
PS_ENFORCER_ADDR=127.0.0.1:8098
PS_ENFORCER_GRPC_ADDR=127.0.0.1:9091

# Dev auth bypass: injects a fake user/admin into requests

PS_DEV_USER_ID=dev-user
PS_DEV_USER_NAME="Dev User"
PS_DEV_USER_EMAIL=dev@example.com
PS_DEV_IS_ADMIN=true
PS_DEV_TENANT_ID=00000000-0000-0000-0000-000000000000

# Allow frontend origin
PS_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Frontend BFF + UI
PORT=3000
PS_GATEWAY_URL=http://127.0.0.1:8098
PS_USE_VITE_DEV=true

# BFF auth bypass + synthetic orgs for selector
PS_DEV_BYPASS_AUTH=true
PS_DEV_TENANTS="00000000-0000-0000-0000-000000000000:Dev Tenant"
SESSION_COOKIE_SECURE=false

# Clerk 
VITE_CLERK_PUBLISHABLE_KEY=pk_test_bHVja3ktc3F1aWQtMTIuY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_SECRET_KEY=sk_test_dEsrLkK0ZJ2DdJBXQJmXRtGfXaEyBrv9vTIiC7NVEt

# Encryption (required for BYOK provider profiles). Generate with: make enc-write-dev
PS_ENCRYPTION_KEY=Eg86rDhL8ris8gRbRAzHms8MMQMCMyWBndANS94EM4I=

# ---- Audit sink (mandatory in dev too; unhealthy or fail fast depending on mode)
PS_AUDIT_REQUIRED=true
PS_AUDIT_REQUIRED_MODE=unhealthy
# Default to file sink for local dev
PS_AUDIT_SINK=file
PS_AUDIT_FILE=./logs/audit-dev.jsonl
# Kafka/Postgres examples (commented)
# PS_AUDIT_SINK=kafka
# PS_AUDIT_KAFKA_BROKERS=localhost:9092
# PS_AUDIT_KAFKA_TOPIC=ps.decisions.dev
# PS_AUDIT_SINK=postgres
# PS_AUDIT_PG_DSN=postgres://user:pass@localhost:5432/postgres?sslmode=disable
# PS_AUDIT_PG_TABLE=audit_events_dev

# ---- Streaming and state (dev)
PS_KAFKA_BROKERS=localhost:9092
PS_TOPIC_DECISIONS=ps.decisions.dev
PS_TOPIC_RAW=ps.raw.dev
PS_TOPIC_SANITIZED=ps.sanitized.dev

PS_PLANSTATE_REDIS_ADDR=localhost:6379
PS_PLANSTATE_PREFIX=psdev
