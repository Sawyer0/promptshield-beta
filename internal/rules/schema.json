{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptshield.io/schemas/rulepack.schema.json",
  "title": "PromptShield RulePack",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "rules"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "pattern": "^promptshield\\.io/v1$"
    },
    "kind": {
      "type": "string",
      "const": "RulePack"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string" },
        "description": { "type": "string" },
        "author": { "type": "string" },
        "authors": { "type": "array", "items": { "type": "string" } },
        "license": { "type": "string" },
        "homepage": { "type": "string" },
        "repository": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "compliance": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    },
    "extends": { "type": "array", "items": { "type": "string" } },
    "imports": { "type": "array", "items": { "type": "string" } },
    "composition": { "$ref": "#/$defs/composition" },
    "performance": { "$ref": "#/$defs/performance" },
    "overrides": {
      "type": "array",
      "items": { "$ref": "#/$defs/override" }
    },
    "context": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "patterns": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action_selector": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "mode": { "type": "string", "enum": ["monitor", "enforce"], "default": "enforce" },
            "allowed_tool_query": { "type": "string" },
            "per_action_timeout_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
            "per_action_rate_limit": { "type": "integer", "minimum": 1, "maximum": 100000 }
          }
        },
        "context_minimization": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "strip_point": { "type": "string", "enum": ["after_plan", "after_tool_selection", "step"], "default": "after_tool_selection" },
            "step": { "type": "integer", "minimum": 0 },
            "mask_token": { "type": "string", "default": "<USER_TEXT>" },
            "retain": { "type": "array", "items": { "type": "string", "enum": ["system_prompt", "tool_schemas", "plan"] } }
          }
        },
        "plan_then_execute": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "max_steps": { "type": "integer", "minimum": 1, "maximum": 100 },
            "drift_policy": { "type": "string", "enum": ["block", "quarantine", "require_approval"], "default": "block" },
            "plan_hash_header": { "type": "string" },
            "signature": { "type": "object", "additionalProperties": false, "properties": { "type": { "type": "string", "enum": ["hmac", "public_key"] }, "key_ref": { "type": "string" } } }
          }
        },
        "map_reduce": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "map_unit": { "type": "string", "enum": ["document", "url", "record"] },
            "map_output": { "type": "string", "enum": ["boolean", "score", "enum", "text"], "default": "score" },
            "text_max_tokens": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "reduce_type": { "type": "string", "enum": ["non_llm", "constrained_llm"], "default": "non_llm" }
          }
        },
        "dual_llm": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "quarantined_tools_disabled": { "type": "boolean", "default": true },
            "bridge_handles_only": { "type": "boolean", "default": true }
          }
        }
      }
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset_id": { "type": "string" },
        "mode": { "type": "string", "enum": ["monitor", "enforce"], "default": "enforce" },
        "arg_contracts": { "type": "array", "items": { "type": "string" } },
        "risk_rules": { "type": "object" },
        "overrides": { "type": "object" }
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "level"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "level": { "type": "integer", "minimum": 1, "maximum": 3 },
        "severity": { "type": "string", "pattern": "^(|INFO|WARNING|HIGH|ERROR|CRITICAL)$" },
        "category": { "type": "string" },
        "enabled": { "type": "boolean" },
        "verifier": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "patterns": {
          "type": "array",
          "items": { "$ref": "#/$defs/pattern" }
        },
        "semantic": { "$ref": "#/$defs/semantic" },
        "fallback": { "$ref": "#/$defs/fallback" },
        "logic": { "type": "string", "pattern": "^(|any|all)$" },
        "options": { "$ref": "#/$defs/options" },
        "response": { "$ref": "#/$defs/response" },
        "cache": { "$ref": "#/$defs/cache" },
        "when": { "$ref": "#/$defs/condition" },
        "unless": { "$ref": "#/$defs/condition" },
        "timeout": { "type": "string" },
        "controls": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "level": { "const": 1 } }, "required": ["level"] },
          "then": { "required": ["keywords"], "properties": { "keywords": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "level": { "const": 2 } }, "required": ["level"] },
          "then": { "required": ["patterns"], "properties": { "patterns": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "level": { "const": 3 } }, "required": ["level"] },
          "then": { "required": ["semantic"], "properties": { "semantic": { "required": ["model", "analysis_prompt"] } } }
        }
      ]
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "case_sensitive": { "type": "boolean" },
        "whole_word": { "type": "boolean" }
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regex"],
      "properties": {
        "name": { "type": "string" },
        "regex": { "type": "string", "minLength": 1 },
        "flags": {
          "type": "array",
          "items": { "type": "string", "enum": ["i", "m", "ignorecase", "multiline"] }
        },
        "verifier": { "type": "string", "enum": ["", "luhn", "ssn_area"] }
      }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string" },
        "temperature": { "type": "number" },
        "max_tokens": { "type": "integer" },
        "analysis_prompt": { "type": "string" },
        "confidence_threshold": { "type": "number" },
        "fallback_on_error": { "type": "boolean" }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "patterns": { "type": "array", "items": { "$ref": "#/$defs/pattern" } },
        "action": { "type": "string" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": { "type": "string" },
        "message": { "type": "string" },
        "replacement": { "type": "string" }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ttl": { "type": "string" },
        "max_entries": { "type": "integer", "minimum": 0 }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": { "type": "string", "enum": ["all_matches", "first_match", "priority_order"] },
        "priority": { "type": "integer", "minimum": 0 }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_length": { "type": "integer", "minimum": 0 },
        "timeout": { "type": "string" },
        "per_rule_timeout": { "type": "string" },
        "total_scan_timeout": { "type": "string" },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "min_token_len": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "override": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rule_id": { "type": "string" },
        "severity": { "type": "string", "pattern": "^(|INFO|WARNING|HIGH|ERROR|CRITICAL)$" },
        "enabled": { "type": "boolean" }
      },
      "required": ["rule_id"]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "match": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}


