-- rules/example.yaml --
apiVersion: promptshield.io/v1
kind: RulePack
metadata:
  name: example
  version: 0.1.0
rules:
  - id: kw
    level: 1
    severity: WARNING
    keywords: ["hello"]
-- input.txt --
hello world
-- script --
go run ./cmd/promptshield validate rules
stdout 'RulePack OK'

go run ./cmd/promptshield scan:file --rulepack rules input.txt
stdout '[WARNING] .*input.txt:1:1'

