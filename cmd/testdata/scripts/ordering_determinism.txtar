-- rules/rp.yaml --
apiVersion: promptshield.io/v1
kind: RulePack
metadata:
  name: rp
  version: 0.1.0
rules:
  - id: hello
    level: 1
    severity: WARNING
    keywords: ["hello"]
-- a.txt --
hello
-- b.txt --
hello
-- script --
# Stylish should print inputs in lexicographic order
go run ./cmd/promptshield scan:file --rulepack rules a.txt b.txt
stdout '(?s)Input: .*a.txt.*Input: .*b.txt'

# JSON prints one object per file; order must be a.txt then b.txt
go run ./cmd/promptshield --output-format=json scan --rulepack rules a.txt b.txt
stdout '(?s)"input"\s*:\s*".*a.txt".*"input"\s*:\s*".*b.txt"'

