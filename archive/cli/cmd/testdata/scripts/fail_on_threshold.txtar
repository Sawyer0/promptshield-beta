-- rules.yaml --
apiVersion: promptshield.io/v1
kind: RulePack
metadata:
  name: test
  version: 1.0.0
rules:
  - id: low
    level: 1
    severity: INFO
    keywords: ["info"]
  - id: med
    level: 1
    severity: WARNING
    keywords: ["warning"]
  - id: high
    level: 1
    severity: HIGH
    keywords: ["danger"]
  - id: crit
    level: 1
    severity: CRITICAL
    keywords: ["critical"]

-- test.txt --
This has info warning danger critical

-- script --
# Should pass with no threshold
go run ./cmd/promptshield scan:file --rulepack rules.yaml test.txt
stdout 'Input: '

# Should fail when threshold is WARNING (has WARNING, HIGH, CRITICAL violations)
! go run ./cmd/promptshield scan:file --fail-on WARNING --rulepack rules.yaml test.txt
stderr 'fail on threshold'

# Should fail when threshold is HIGH
! go run ./cmd/promptshield scan:file --fail-on HIGH --rulepack rules.yaml test.txt
stderr 'fail on threshold'

# Should fail when threshold is CRITICAL
! go run ./cmd/promptshield scan:file --fail-on CRITICAL --rulepack rules.yaml test.txt
stderr 'fail on threshold'

# Should pass when threshold is ERROR (no ERROR violations in this set)
go run ./cmd/promptshield scan:file --fail-on ERROR --rulepack rules.yaml test.txt
stdout 'Input: '
! stderr 'fail on threshold'