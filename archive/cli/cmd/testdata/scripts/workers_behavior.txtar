-- rules/rp.yaml --
apiVersion: promptshield.io/v1
kind: RulePack
metadata:
  name: rp
  version: 0.1.0
rules:
  - id: hello
    level: 1
    severity: WARNING
    keywords: ["hello"]
-- a.txt --
hello
-- b.txt --
hello
-- c.txt --
hello
-- d.txt --
hello
-- e.txt --
hello
-- f.txt --
hello
-- script --
# default (auto workers): ensure deterministic order a..f
go run ./cmd/promptshield scan:file --rulepack rules a.txt b.txt c.txt d.txt e.txt f.txt
stdout '(?s)Input: .*a.txt.*Input: .*b.txt.*Input: .*c.txt.*Input: .*d.txt.*Input: .*e.txt.*Input: .*f.txt'

# single worker: same order
env PS_WORKERS=1
go run ./cmd/promptshield scan:file --rulepack rules a.txt b.txt c.txt d.txt e.txt f.txt
stdout '(?s)Input: .*a.txt.*Input: .*b.txt.*Input: .*c.txt.*Input: .*d.txt.*Input: .*e.txt.*Input: .*f.txt'

# oversubscribed workers: same order
env PS_WORKERS=100
go run ./cmd/promptshield scan:file --rulepack rules a.txt b.txt c.txt d.txt e.txt f.txt
stdout '(?s)Input: .*a.txt.*Input: .*b.txt.*Input: .*c.txt.*Input: .*d.txt.*Input: .*e.txt.*Input: .*f.txt'

