-- rules.yaml --
apiVersion: promptshield.io/v1
kind: RulePack
metadata:
  name: context-test
  version: 1.0.0
context:
  environment: dev
rules:
  - id: prod-only
    level: 1
    severity: HIGH
    keywords: ["secret"]
    when:
      match:
        environment: ["production", "staging"]
  - id: not-dev
    level: 1
    severity: HIGH
    keywords: ["password"]
    unless:
      match:
        environment: ["dev", "development"]
  - id: always
    level: 1
    severity: LOW
    keywords: ["todo"]

-- test.txt --
secret password todo

-- script --
# Default context from rulepack (dev) - prod-only won't match, not-dev won't match
go run ./cmd/promptshield scan:file --rulepack rules.yaml test.txt
stdout 'todo'
! stdout 'secret'
! stdout 'password'

# Override context to production - prod-only matches, not-dev matches
go run ./cmd/promptshield scan:file --rulepack rules.yaml --context environment=production test.txt
stdout 'secret'
stdout 'password'
stdout 'todo'

# Override to development - same as dev
go run ./cmd/promptshield scan:file --rulepack rules.yaml --context environment=development test.txt
stdout 'todo'
! stdout 'secret'
! stdout 'password'