-- rules.yaml --
apiVersion: promptshield.io/v1
kind: RulePack
metadata:
  name: test
  version: 1.0.0
rules:
  - id: secrets
    level: 1
    severity: HIGH
    keywords: ["secret", "password", "token"]

-- dir1/file1.txt --
This has a secret

-- dir1/file2.txt --
This has a password

-- dir2/file3.txt --
This has a token

-- dir2/subdir/file4.txt --
Another secret here

-- clean.txt --
This file is clean

-- script --
# Scan multiple files explicitly
go run ./cmd/promptshield scan:file --rulepack rules.yaml dir1/file1.txt dir1/file2.txt
stdout 'file1.txt'
stdout 'file2.txt'
stdout '2 files scanned'

# Scan directory recursively
go run ./cmd/promptshield scan:directory --rulepack rules.yaml dir1
stdout 'file1.txt'
stdout 'file2.txt'
stdout '2 files scanned'

# Scan with glob pattern
go run ./cmd/promptshield scan:file --rulepack rules.yaml 'dir2/**/*.txt'
stdout 'file3.txt'
stdout 'file4.txt'

# Mixed files and directories
go run ./cmd/promptshield scan:file --rulepack rules.yaml clean.txt dir1
stdout 'clean.txt'
stdout 'file1.txt'
stdout 'file2.txt'
stdout '3 files scanned'

# Verify deterministic ordering
go run ./cmd/promptshield scan:file --rulepack rules.yaml dir2 dir1 > out1.txt
go run ./cmd/promptshield scan:file --rulepack rules.yaml dir2 dir1 > out2.txt
cmp out1.txt out2.txt