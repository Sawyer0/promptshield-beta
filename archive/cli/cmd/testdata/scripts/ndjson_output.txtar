-- rules/rp.yaml --
apiVersion: promptshield.io/v1
kind: RulePack
metadata:
  name: rp
  version: 0.1.0
rules:
  - id: hello
    level: 1
    severity: WARNING
    keywords: ["hello"]
-- a.txt --
hello
-- b.txt --
hello
-- script --
go run ./cmd/promptshield --output-format=ndjson scan:file --rulepack rules a.txt b.txt
# Three JSON lines: 1 violation + 1 violation + 1 summary
stdout '^{.*}\n{.*}\n{.*}\n?$'
stdout '"type"\s*:\s*"violation"'
stdout '"type"\s*:\s*"summary"'

