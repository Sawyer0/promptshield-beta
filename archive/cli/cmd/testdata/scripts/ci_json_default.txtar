-- rules/rp.yaml --
apiVersion: promptshield.io/v1
kind: RulePack
metadata:
  name: rp
  version: 0.1.0
rules:
  - id: hello
    level: 1
    severity: WARNING
    keywords: ["hello"]

-- input.txt --
hello

-- script --
# In CI, default output should be JSON unless user overrides
env GITHUB_ACTIONS=1
go run ./cmd/promptshield scan:file --rulepack rules input.txt
stdout '"rule_id"\s*:\s*"hello"'
stdout '"input"\s*:\s*".*input.txt"'

