-- rules/rp.yaml --
apiVersion: promptshield.io/v1
kind: RulePack
metadata:
  name: rp
  version: 0.1.0
rules:
  - id: hello
    level: 1
    severity: WARNING
    keywords: ["hello"]
-- input.txt --
hello
-- script --
# default is stylish
go run ./cmd/promptshield scan:file --rulepack rules input.txt
stdout '\[WARNING\]'

# env overrides config defaults
env PS_OUTPUT_FORMAT=json
go run ./cmd/promptshield scan:file --rulepack rules input.txt
stdout '"rule_id":\s*"hello"'

# --json shorthand overrides everything
go run ./cmd/promptshield --json scan:file --rulepack rules input.txt
stdout '"rule_id":\s*"hello"'

