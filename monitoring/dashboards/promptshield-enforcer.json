{
  "id": null,
  "uid": null,
  "title": "PromptShield Enforcer",
  "tags": ["promptshield", "enforcer", "security"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "graph",
      "title": "HTTP Requests Rate by Path/Code",
      "id": 1,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (path,code) (rate(ps_enforcer_requests_total[5m]))",
          "legendFormat": "{{path}} {{code}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "graph",
      "title": "Decision Rate (HTTP)",
      "id": 2,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (decision) (rate(ps_enforcer_decisions_total[5m]))",
          "legendFormat": "{{decision}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "graph",
      "title": "HTTP p95 Request Duration (s)",
      "id": 3,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ps_enforcer_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "type": "graph",
      "title": "gRPC Streams Rate by Decision",
      "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (decision) (rate(ps_extproc_streams_total[5m]))",
          "legendFormat": "{{decision}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "graph",
      "title": "gRPC p95 Stream Duration (s)",
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ps_extproc_stream_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "type": "graph",
      "title": "gRPC Stream Bytes Rate",
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "rate(ps_extproc_bytes_total[5m])",
          "legendFormat": "bytes/s",
          "refId": "A"
        }
      ]
    }
  ]
}


