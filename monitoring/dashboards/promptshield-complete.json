{
  "id": null,
  "uid": "promptshield-complete",
  "title": "PromptShield Complete Monitoring",
  "description": "Comprehensive monitoring dashboard for PromptShield security gateway",
  "tags": ["promptshield", "security", "monitoring", "sla"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "tenant_id",
        "type": "query",
        "query": "label_values(ps_requests_total, tenant_id)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "System Status",
      "id": 1,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "up{job=\"promptshield\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Total Requests",
      "id": 2,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(ps_requests_total{tenant_id=~\"$tenant_id\"}[1m])) * 60",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "type": "stat",
      "title": "Violations Blocked",
      "id": 3,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(ps_violations_total{tenant_id=~\"$tenant_id\"}[1m])) * 60",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "vpm",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "SLA Compliance",
      "id": 4,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "((sum(ps_requests_total{tenant_id=~\"$tenant_id\"}) - sum(ps_errors_total{tenant_id=~\"$tenant_id\"})) / sum(ps_requests_total{tenant_id=~\"$tenant_id\"})) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          },
          "min": 95,
          "max": 100
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Request Rate & Response Times",
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(ps_requests_total{tenant_id=~\"$tenant_id\"}[5m]))",
          "legendFormat": "Request Rate",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(ps_request_duration_seconds_bucket{tenant_id=~\"$tenant_id\"}[5m])) by (le)) * 1000",
          "legendFormat": "P50 Latency (ms)",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ps_request_duration_seconds_bucket{tenant_id=~\"$tenant_id\"}[5m])) by (le)) * 1000",
          "legendFormat": "P95 Latency (ms)",
          "refId": "C"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(ps_request_duration_seconds_bucket{tenant_id=~\"$tenant_id\"}[5m])) by (le)) * 1000",
          "legendFormat": "P99 Latency (ms)",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Request Rate" },
            "properties": [{ "id": "unit", "value": "rps" }]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Security Violations by Severity",
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum by (severity) (rate(ps_violations_total{tenant_id=~\"$tenant_id\"}[5m]))",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "stacking": { "mode": "normal" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "CRITICAL" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "HIGH" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "MEDIUM" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }]
          },
          {
            "matcher": { "id": "byName", "options": "LOW" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          }
        ]
      }
    },
    {
      "type": "piechart",
      "title": "Enforcement Actions",
      "id": 7,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum by (decision) (ps_requests_total{tenant_id=~\"$tenant_id\"})",
          "legendFormat": "{{decision}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "displayMode": "table",
            "reduceOptions": { "values": false, "calcs": ["lastNotNull"] }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "allow" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "deny" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      }
    },
    {
      "type": "bargauge",
      "title": "Top Triggered Rules",
      "id": 8,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "targets": [
        {
          "expr": "topk(10, sum by (rule_id) (ps_violations_total{tenant_id=~\"$tenant_id\"}))",
          "legendFormat": "{{rule_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "orientation": "horizontal",
            "displayMode": "gradient"
          },
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "type": "heatmap",
      "title": "Response Time Distribution",
      "id": 9,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "targets": [
        {
          "expr": "sum(rate(ps_request_duration_seconds_bucket{tenant_id=~\"$tenant_id\"}[5m])) by (le)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Recent Alerts",
      "id": 10,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "ALERTS{alertname=~\"PromptShield.*\"}",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": {
              "alertname": "Alert",
              "severity": "Severity",
              "summary": "Summary",
              "description": "Description"
            }
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error Rates by Type",
      "id": 11,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "sum by (error_type) (rate(ps_errors_total{tenant_id=~\"$tenant_id\"}[5m]))",
          "legendFormat": "{{error_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Cache Hit Rates",
      "id": 12,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        {
          "expr": "rate(ps_cache_hits_total{tenant_id=~\"$tenant_id\"}[5m]) / (rate(ps_cache_hits_total{tenant_id=~\"$tenant_id\"}[5m]) + rate(ps_cache_misses_total{tenant_id=~\"$tenant_id\"}[5m]))",
          "legendFormat": "Hit Rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      }
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Deployments",
        "datasource": "prometheus",
        "enable": true,
        "expr": "changes(ps_build_info[1h])",
        "iconColor": "blue",
        "titleFormat": "Deployment",
        "textFormat": "New version deployed"
      }
    ]
  },
  "links": [
    {
      "title": "Detailed Logs",
      "url": "/d/logs",
      "type": "dashboards"
    },
    {
      "title": "Alert Manager",
      "url": "/alertmanager",
      "type": "link"
    }
  ]
}