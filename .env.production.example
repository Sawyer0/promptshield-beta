# PromptShield Production Environment Configuration
# Copy this file to .env.production and fill in your values

# ============================================
# DATABASE CONFIGURATION (Required)
# ============================================
# Supabase PostgreSQL connection
PS_DB_HOST=your-project.supabase.co
PS_DB_PORT=5432
PS_DB_NAME=postgres
PS_DB_USER=postgres
PS_DB_PASSWORD=your-secure-password
PS_DB_SSLMODE=require

# Connection pooling settings
PS_DB_MAX_OPEN_CONNS=25
PS_DB_MAX_IDLE_CONNS=5
PS_DB_CONN_MAX_LIFETIME=1h

# ============================================
# ENFORCER CONFIGURATION
# ============================================
# Server addresses
PS_ENFORCER_ADDR=:9090
PS_ENFORCER_GRPC_ADDR=:9091

# Enforcement settings
PS_ENFORCER_MODE=enforce
PS_ENFORCER_ENFORCEMENT_MODE=enforce
PS_ENFORCER_TIMEOUT=300ms
PS_ENFORCER_MAX_BODY_BYTES=10485760
PS_ENFORCER_FAIL_ON=HIGH

# TLS Configuration (for production)
PS_ENFORCER_TLS_MODE=disable
PS_ENFORCER_GRPC_TLS_MODE=disable
# PS_ENFORCER_TLS_CERT=/path/to/cert.pem
# PS_ENFORCER_TLS_KEY=/path/to/key.pem

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
# Admin token for API access (generate a secure token)
PS_ADMIN_TOKEN=generate-a-secure-token-here

# Optional: Enforcer auth token for additional security
PS_ENFORCER_AUTH_TOKEN=

# Development mode (NEVER set to true in production)
PS_DEV_MODE=false

# ============================================
# LLM PROVIDER CONFIGURATION
# ============================================
# Semantic analysis settings
PS_SEMANTIC_ENABLED=true
PS_SEMANTIC_TIMEOUT=100ms
PS_SEMANTIC_CACHE_TTL=15m

# OpenAI API Key (for semantic analysis)
OPENAI_API_KEY=sk-your-openai-api-key

# Azure OpenAI (optional)
AZURE_OPENAI_ENDPOINT=your-resource.openai.azure.com
AZURE_OPENAI_KEY=your-azure-key

# ============================================
# TELEMETRY & MONITORING
# ============================================
# OpenTelemetry configuration
PS_TELEMETRY=1
PS_TELEMETRY_ENDPOINT=otel-collector:4317

# Prometheus metrics
PS_METRICS_ENABLED=true
PS_METRICS_PATH=/metrics

# ============================================
# LICENSING
# ============================================
PROMPTSHIELD_LICENSE_KEY=your-license-key

# ============================================
# PERFORMANCE TUNING
# ============================================
# Worker pool size (0 = auto-detect based on CPU cores)
PS_WORKERS=0

# Scanner settings
PS_SCANNER_WINDOW_SIZE=65536
PS_SCANNER_OVERLAP_SIZE=1024

# Rate limiting
PS_RATE_LIMIT_RPS=100
PS_RATE_LIMIT_BURST=200

# ============================================
# LOGGING & DEBUGGING
# ============================================
# Log level: debug, info, warn, error
PS_LOG_LEVEL=info

# Log format: json, text
PS_LOG_FORMAT=json

# Audit log settings
PS_AUDIT_ENABLED=true
PS_AUDIT_PATH=/var/log/promptshield/audit.log
PS_AUDIT_ROTATION=daily
PS_AUDIT_RETENTION_DAYS=90

# ============================================
# DOCKER/KUBERNETES SPECIFIC
# ============================================
# Health check settings
PS_HEALTH_CHECK_INTERVAL=30s
PS_READINESS_CHECK_INTERVAL=10s

# Graceful shutdown timeout
PS_SHUTDOWN_TIMEOUT=30s

# ============================================
# GRAFANA MONITORING (optional)
# ============================================
GRAFANA_PASSWORD=secure-grafana-password

# ============================================
# HYPERSCAN (optional performance boost)
# ============================================
ENABLE_HYPERSCAN=0
PS_HYPERSCAN=false