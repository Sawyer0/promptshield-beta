{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptshield.io/schemas/framework.schema.json",
  "title": "Compliance Framework",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "name", "publisher", "version", "license_type", "default_locale"],
  "properties": {
    "key": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "jurisdiction": { "type": "array", "items": { "type": "string" } },
    "publisher": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "license_type": { "type": "string", "enum": ["public_domain", "summary_only", "custom"] },
    "default_locale": { "type": "string", "minLength": 2 },
    "references": { "type": "array", "items": { "type": "string", "format": "uri" } },
    "meta": { "type": "object", "additionalProperties": true }
  }
}

